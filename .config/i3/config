set $mod Mod4

set $background ~/Backgrounds/forest-hut.jpg
set $locksreen 

# Force workspaces to specific monitors
workspace 1 output eDP-1
workspace 2 output eDP-1
workspace 3 output eDP-1
workspace 4 output eDP-1
workspace 5 output eDP-1
workspace 6 output DP-1-0.2
workspace 7 output DP-1-0.2
workspace 8 output DP-1-0.3
workspace 9 output DP-1-0.3
workspace 10 output eDP-1

# Enable window borders, hide default titlebar
client.focused          #458588 #458588 #458588 #458588
for_window [class="^.*"] border pixel 2

# Gap config
gaps outer 0
gaps inner 20

# Drag floating windows
floating_modifier $mod

# Kill focused window
bindsym $mod+q kill

# Start terminal
# requires alacritty running as a daemon
# see: ~/.config/systemd/user/alacritty.service
bindsym $mod+Return exec alacritty msg create-window

# Start browser 
bindsym $mod+w exec firefox 

# Start pavu
bindsym $mod+a exec pavucontrol

# Start rofi
bindsym $mod+d exec "rofi -show drun"

# Start rofi in command mode 
bindsym $mod+Shift+d exec "rofi -show run"

# Take screenshot
bindsym $mod+Shift+s exec flameshot gui

# File manager 
bindsym $mod+t exec pcmanfm

# Obsidian
bindsym $mod+o exec obsidian

# Network settings
bindsym $mod+n exec alacritty msg create-window --command nmtui

# Change performance profile
bindsym $mod+P exec asusctl profile -n && sleep 0.2 && notify-send -u critical -t 3000 "$(asusctl profile -p | tail -3 | head -n 1)" -a Asusctl

# Get graphics profile
bindsym $mod+G exec notify-send -u critical -t 3000 "Active profile is $(supergfxctl -g)" -a Supergfxctl

# Bind audio keys to pactl volume control
bindsym XF86AudioRaiseVolume        exec pamixer -i 5
bindsym XF86AudioLowerVolume        exec pamixer -d 5
bindsym XF86AudioMute               exec pamixer -t

# Enable functionality for brightness keys
bindsym XF86MonBrightnessUp           exec sudo brightnessctl s 15+%
bindsym XF86MonBrightnessDown         exec sudo brightnessctl s 15-%

# i3lock
bindsym $mod+control+l exec i3lock -i $locksreen

# Change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Enter fullscreen mode
bindsym $mod+f fullscreen toggle

# Enter super fullscreen mode
bindsym $mod+Shift+f fullscreen global

# Toggle floating mode
bindsym $mod+Shift+space floating toggle

# Toggle focus between floating and main window
bindsym $mod+space focus mode_toggle

# Bind keys to switch to next workspace
bindsym $mod+bracketright workspace next
bindsym $mod+bracketleft workspace prev

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Reload the configuration file
bindsym $mod+Shift+c reload

# Restart i3 inplace
bindsym $mod+Shift+r restart

# Send currently focused window to a scratchpad (minimize)
bindsym $mod+M move scratchpad
bindsym $mod+Shift+M scratchpad show

# Setup wallpaper
exec_always feh --bg-fill $background

# Remap keybinds
exec_always --no-startup-id xmodmap ~/.Xresources

# Set proper key repeat timings
exec_always --no-startup-id xset r rate 300 50

# Long running daemon-type stuff:
exec_always --no-startup-id sh -c "pkill polybar; ~/.config/polybar/launch.sh"
exec_always --no-startup-id sh -c "pkill dunst; dunst"
exec_always --no-startup-id sh -c "pkill flameshot; flameshot"
exec_always --no-startup-id sh -c "pkill picom; picom"
exec_always --no-startup-id alacritty --daemon
